# =============================================================================
# Shared env for all microfrontends (native Vercel Microfrontends).
# Copy to `.env` at the repo root for local dev. On Vercel, set per-project.
# =============================================================================

# --- Secrets (server-only; NOT prefixed NEXT_PUBLIC => never in browser) ------

# Signs the mock session cookie (HMAC). Same value in ALL zones so any zone can
# verify the cookie. DEMO ONLY — use a strong secret from a secret manager IRL.
SESSION_SECRET=dev-only-insecure-secret-change-me

# --- Public origin ------------------------------------------------------------

# The ONE origin users visit. Used for absolute cross-zone server redirects.
#   dev:  http://localhost:3024   (the microfrontends local proxy)
#   prod: https://abc.com         (production domain of the default app / shell)
NEXT_PUBLIC_BASE_URL=http://localhost:3024

# --- Cookie domain (leave EMPTY for single-domain composition) ----------------
# Only set (".example.com") if you switch to a subdomain layout.
COOKIE_DOMAIN=

# NOTE: Routing between zones is handled by microfrontends.json + Vercel (and the
# local proxy). There are no *_ZONE_URL variables anymore.
